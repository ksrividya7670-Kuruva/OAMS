# Server Environment
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:5173

# Database (PostgreSQL 16)
DATABASE_URL=postgres://oams_user:oams_password@localhost:5432/oams_db

# Redis 7
REDIS_URL=redis://localhost:6379

# Email (MailHog for local dev, or external SMTP like Microsoft 365)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@oams.local
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# SMTP_SECURE=false

# Microsoft Power Automate Webhook (Instant Cloud Flow HTTP Trigger)
# POWER_AUTOMATE_WEBHOOK_URL=https://prod-XX.westus.logic.azure.com:443/workflows/...
# POWER_AUTOMATE_SECRET=optional-hmac-secret

# Security
JWT_SECRET=super-secret-development-key-that-is-at-least-32-bytes-long

# Logging
LOG_LEVEL=info
